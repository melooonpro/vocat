menu "VoCat Desktop"

    config VOCAT_WIFI_SSID
        string "Wi-Fi SSID"
        default ""
        help
            Wireless network name used by the desktop clock.

    config VOCAT_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""
        help
            Leave empty only for an open wireless network.

    config VOCAT_TIMEZONE
        string "POSIX timezone"
        default "CST-8"
        help
            POSIX TZ string. China Standard Time is CST-8.

    config VOCAT_NTP_SERVER
        string "NTP server"
        default "ntp.aliyun.com"

    config VOCAT_CLOCK_24_HOUR
        bool "Use 24-hour time"
        default y

    config VOCAT_DEBUG_UART_ENABLE
        bool "Enable secondary debug UART"
        default y
        help
            Copy application log output to a separate hardware UART. This
            does not change the USB Serial/JTAG console used for flashing.

    config VOCAT_DEBUG_UART_PORT
        int "Secondary debug UART port"
        range 0 2
        default 1
        depends on VOCAT_DEBUG_UART_ENABLE

    config VOCAT_DEBUG_UART_TX_GPIO
        int "Secondary debug UART TX GPIO"
        range -1 48
        default 5
        depends on VOCAT_DEBUG_UART_ENABLE

    config VOCAT_DEBUG_UART_RX_GPIO
        int "Secondary debug UART RX GPIO"
        range -1 48
        default 6
        depends on VOCAT_DEBUG_UART_ENABLE

    config VOCAT_DEBUG_UART_BAUDRATE
        int "Secondary debug UART baud rate"
        range 1200 2000000
        default 115200
        depends on VOCAT_DEBUG_UART_ENABLE

endmenu
